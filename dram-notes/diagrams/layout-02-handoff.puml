@startuml
skinparam defaultFontName "Noto Sans CJK TC"
title DRAM 大小、保留區怎麼一棒一棒往下傳

participant "libdram\n（在 BL2 裡）" as lib
participant "BL2" as bl2
participant "0x40000100\nBOOT_ARGUMENT" as ba
participant "BL31" as bl31
participant "OP-TEE" as tee
participant "U-Boot" as ub
participant "Linux" as k

lib -> lib : 讀 MR8 → 每 rank 4 GiB\n2 rank → 0x2_0000_0000
lib -> ba : mblock_reserve()\ndramc-rk0／rk1 各 8 KiB
lib -> bl2 : platform_memory_size()
bl2 -> ba : dram_size、magic "LPLP"
bl2 -> bl31 : 跳過去
bl31 -> bl31 : SMPU region 1/2\n（位址寫死在 platform_def.h）
bl31 -> tee : 啟動
tee -> tee : register_ddr(0x40000000, 0x200000000)\n（Yocto 的 OPTEE_DRAM_SIZE 寫死）
bl31 -> ub : 跳過去
ub -> ba : dram_init() 讀 dram_size
ub -> k : bootm：arch_fixup_fdt()\n• /memory = gd->ram_base + gd->ram_size（8 GiB）\nft_board_setup()\n• 加 dramc-rk0/1 進 /reserved-memory
k -> k : memblock、reserved mem、CMA
@enduml
