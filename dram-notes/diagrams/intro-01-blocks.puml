@startuml
skinparam defaultFontName "Noto Sans CJK TC"
skinparam rectangleBorderColor #555
title DRAM 相關方塊（Genio 720 / MT8189，LPDDR5 8 GiB）

rectangle "CPU（8 核）\nGPU、顯示、USB、UFS…\n（都是 master）" as m
rectangle "EMI\n記憶體匯流排入口\n位址 → channel／rank\nSMPU 保護區在這裡檢查" as emi
rectangle "DRAMC CHA\nDRAMC_AO 0x10230000\nDDRPHY_AO 0x10238000" as cha
rectangle "DRAMC CHB\nDRAMC_AO 0x10240000\nDDRPHY_AO 0x10248000" as chb
rectangle "LPDDR5 CHA\nrank0 + rank1" as da
rectangle "LPDDR5 CHB\nrank0 + rank1" as db
rectangle "DPM ×2（每個 channel 一顆小 MCU）\n0x10900000 / 0x10A00000\nBL31 載韌體\n管 self-refresh、換頻" as dpm
rectangle "DVFSRC 0x1C00F000\n收集「要多少頻寬／電壓」的投票" as dvfsrc
rectangle "SPM\n整機睡眠流程（韌體）" as spm
rectangle "PMIC（MT6359＋MT6319）\nVcore、VDDQ、VDD2H、VMDDR…" as pmic

m --> emi
emi --> cha
emi --> chb
cha --> da
chb --> db
dpm ..> cha
dpm ..> chb
dvfsrc ..> spm
spm ..> dpm
spm ..> pmic
pmic ..> da
pmic ..> db
@enduml
