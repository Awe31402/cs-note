@startuml
skinparam defaultFontName "Noto Sans CJK TC"
skinparam rectangleBorderColor #555
title LK（燒錄時）vs BL2（每次開機）初始化 DRAM 的順序

rectangle "LK  lk.bin（prebuilt，跑在 L3C）" as L {
  rectangle "1. UART、GIC、timer、WDT" as l1
  rectangle "2. mt_pll_init()" as l2
  rectangle "3. PMIF／SPMI／PWRAP／I2C\n（沒有 pmic_init、clk_buf）" as l3
  rectangle "4. MMU 先對好 DRAM 位址" as l4
  rectangle "5. mt_mem_init()  libdram-lk ca5e1f7\n• 讀不到 regulator（電壓都印 -1）\n• 偵測：LPDDR5、2 rank、8 GiB\n• 只校 3200 Mbps 一組（完整校正）\n• 不讀、不寫 dramk\n約 0.8 s（UART 主機時間，粗估）" as l5 #lightyellow
  rectangle "6. 寫 0xfab0fab1… 到 DRAM、開 D-cache\n→ fastboot" as l6
  l1 -down-> l2
  l2 -down-> l3
  l3 -down-> l4
  l4 -down-> l5
  l5 -down-> l6
}

rectangle "BL2  bl2.img（跑在 SRAM，MMU 關）" as B {
  rectangle "1. timer、WDT、mt_pll_init()、thermal" as b1
  rectangle "2. PMIF／SPMI／PWRAP／I2C\n＋pmic_init、mminfra、srclken、clk_buf\n（129 ms）" as b2
  rectangle "3. 讀開機腳位 → UFS init → 讀 GPT\n（53～95 ms）" as b3
  rectangle "4. get_part_addr(dramk) = 0x4880000" as b4
  rectangle "5. mt_mem_init()  libdram 315bfaa\n• 電壓讀得到（Vcore 800 mV…）\n• 5 組 shuffle 都設\n• 用 dramk 存的校正值\n• TA2＋CPU mem test\n219 ms" as b5 #lightyellow
  rectangle "6. BOOT_ARGUMENT、mblock 保留\n→ 讀 FIP → 跳 BL31" as b6
  b1 -down-> b2
  b2 -down-> b3
  b3 -down-> b4
  b4 -down-> b5
  b5 -down-> b6
}
L -[hidden]right- B
@enduml
