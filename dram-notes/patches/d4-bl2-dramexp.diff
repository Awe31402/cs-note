diff --git a/plat/mediatek/mt8391/bl2_plat_setup.c b/plat/mediatek/mt8391/bl2_plat_setup.c
index ec3da6f27..79673aa9e 100644
--- a/plat/mediatek/mt8391/bl2_plat_setup.c
+++ b/plat/mediatek/mt8391/bl2_plat_setup.c
@@ -33,6 +33,29 @@ uint32_t g_ddr_reserve_enable;
 uint32_t g_ddr_reserve_success;
 
 static uint32_t buf_in_sram[PLAT_PARTITION_BLOCK_SIZE / sizeof(uint32_t)];
+
+/* DRAMEXP: read-only timing/register log for the DRAM notes (not for upstream) */
+#include <arch_helpers.h>
+static uint64_t dramexp_t0;
+static void dramexp_ts(const char *tag)
+{
+	uint64_t c = read_cntpct_el0();
+	uint64_t f = read_cntfrq_el0();
+
+	NOTICE("DRAMEXP %s: cntpct=%llu (%llu us since bl2_platform_setup)\n", tag,
+	       (unsigned long long)c, (unsigned long long)((c - dramexp_t0) * 1000000ULL / f));
+}
+static void dramexp_regs(const char *tag)
+{
+	/* DDRPHY_AO DVFS_STATUS (+0xC7C) and DRAMC_AO SA_RESERVE (+0x00C), CHA/CHB */
+	NOTICE("DRAMEXP %s: CHA DVFS_STATUS=0x%x SA_RSV=0x%x CHB DVFS_STATUS=0x%x SA_RSV=0x%x\n", tag,
+	       mmio_read_32(0x10238C7C), mmio_read_32(0x1023000C),
+	       mmio_read_32(0x10248C7C), mmio_read_32(0x1024000C));
+	/* DVFSRC_TOP (0x1c00f000) first words */
+	NOTICE("DRAMEXP %s: DVFSRC +0x0=0x%x +0x4=0x%x +0x8=0x%x +0xc=0x%x +0x290=0x%x\n", tag,
+	       mmio_read_32(0x1C00F000), mmio_read_32(0x1C00F004), mmio_read_32(0x1C00F008),
+	       mmio_read_32(0x1C00F00C), mmio_read_32(0x1C00F290));
+}
 static io_block_dev_spec_t *boot_dev_spec;
 
 static uint32_t ufs_desc_in_sram[0x8000] __aligned(4096);
@@ -152,8 +175,10 @@ void bl2_platform_setup(void)
 {
 	uint32_t storage_type;
 
+	dramexp_t0 = read_cntpct_el0();
 	generic_delay_timer_init();
 	mtk_wdt_init();
+	dramexp_ts("start");
 
 	mt_pll_init();
 
@@ -169,6 +194,7 @@ void bl2_platform_setup(void)
 	mminfra_init();
 	srclken_rc_init();
 	clk_buf_init();
+	dramexp_ts("pmic/clk done");
 
 	storage_type = mt_get_storage_type();
 
@@ -189,11 +215,25 @@ void bl2_platform_setup(void)
 	mtk_io_setup((uintptr_t)boot_dev_spec);
 	load_partition_table(GPT_IMAGE_ID);
 
+	dramexp_ts("storage+gpt done");
+	NOTICE("DRAMEXP dramk part addr=0x%llx\n", (unsigned long long)get_part_addr("dramk"));
 	blkdev_set_dramk_data_offset(get_part_addr("dramk"));
 	mt_mem_init();
+	dramexp_ts("mt_mem_init done");
+	dramexp_regs("after mt_mem_init");
 
 	BOOT_ARGUMENT->dram_size = platform_memory_size();
 	BOOT_ARGUMENT->magic_number = BOOT_ARGUMENT_MAGIC;
+	NOTICE("DRAMEXP BOOT_ARGUMENT@%p dram_size=0x%llx\n", (void *)BOOT_ARGUMENT,
+	       (unsigned long long)BOOT_ARGUMENT->dram_size);
+	NOTICE("DRAMEXP mblock magic=0x%x reserved_num=%u\n",
+	       BOOT_ARGUMENT->mblock_info.magic_number, BOOT_ARGUMENT->mblock_info.reserved_num);
+	for (int i = 0; i < (int)BOOT_ARGUMENT->mblock_info.reserved_num && i < MBLOCK_RESERVED_NUM_MAX; i++)
+		NOTICE("DRAMEXP mblock[%d] start=0x%llx size=0x%llx map=%u name=%s\n", i,
+		       (unsigned long long)BOOT_ARGUMENT->mblock_info.reserved[i].start,
+		       (unsigned long long)BOOT_ARGUMENT->mblock_info.reserved[i].size,
+		       BOOT_ARGUMENT->mblock_info.reserved[i].mapping,
+		       BOOT_ARGUMENT->mblock_info.reserved[i].name);
 
 	/* change storage read buffer to DRAM */
 	boot_dev_spec->buffer.offset = 0x41000000;
